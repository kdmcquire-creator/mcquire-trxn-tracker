{
  "name": "mcquire-tracker",
  "version": "1.0.8",
  "description": "McQuire Financial Tracker — Desktop Application",
  "main": "dist-electron/main/index.js",
  "author": "Kyle McQuire",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:unpackaged": "taskkill /F /IM \"McQuire Tracker.exe\" /T 2>nul & rmdir /S /Q dist-installer 2>nul & electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "chokidar": "^3.6.0",
    "electron-updater": "^6.1.7",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.4",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "plaid": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sql.js": "^1.11.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.14",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.mcquire.tracker",
    "productName": "McQuire Tracker",
    "directories": {
      "output": "dist-installer"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kdmcquire-creator",
        "repo": "mcq-tx-track",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "McQuire Tracker"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "resources/**/*"
    ],
    "asarUnpack": []
  }
}
